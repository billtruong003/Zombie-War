# Unity auto-generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/.rider*.meta
[Aa]ssets/[Rr]ider*

# Visual Studio / Rider cache
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db

# Claude Code local/session state - but NOT .claude/skills/, which is project-scoped
# knowledge (e.g. billgamecore) meant to travel with the repo, same as TOSSZONE does it.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/shell-snapshots/

# VSCode Local History extension cache
.lh/

# unity-mcp runtime log folder (auto-generated by the Editor plugin)
Assets/UnityMCP/

# Scratch Unity audit projects (full duplicate of Assets/, ~1.4 GB) - never commit
/.utmp/AssetAuditProject/
/.utmp/AssetAuditLite/

# Env Sandbox maps and palette-kit meshes/prefabs are generated (HordeCall/World/Palette/Build Palette Kit,
# then Build Env Sandbox) and committed: their meshes are binary stores tracked by LFS (.gitattributes).

# Firebase / EDM output, regenerated by the editor plugins from Packages/ and the google-services.json
/[Aa]ssets/GeneratedLocalRepo/
/[Aa]ssets/GeneratedLocalRepo.meta
/[Aa]ssets/StreamingAssets/google-services-desktop.json
/[Aa]ssets/StreamingAssets/google-services-desktop.json.meta
/[Aa]ssets/Plugins/Android/FirebaseApp.androidlib/
/[Aa]ssets/Plugins/Android/FirebaseApp.androidlib.meta
/[Aa]ssets/Plugins/Android/FirebaseCrashlytics.androidlib/
/[Aa]ssets/Plugins/Android/FirebaseCrashlytics.androidlib.meta

# Addressables for Android build output (regenerated each build)
/[Aa]ssets/PlayAssetDelivery/Build/
/[Aa]ssets/PlayAssetDelivery/Build.meta

# Native build intermediates (Unity Android/CMake)
/.utmp/
